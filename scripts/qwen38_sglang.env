# Snapshot of the LIVE recipe on asus2 (~/qwen38-sglang-recipe/.env).
# Updated 2026-09-12 after the speed-tuning session — matches the pinned
# "config D": native 262K, bf16 KV, decode CUDA graphs ON.
# See HANDOFF-20260912-qwen38-speed-tuning.md for the A/B evidence.
HEAD_CX7_IP=10.77.0.5
WORKER_CX7_IP=10.77.0.6
HEAD_CX7_IF=enp1s0f1np1
WORKER_CX7_IF=enp1s0f1np1
HEAD_CX7_IB=rocep1s0f1
WORKER_CX7_IB=rocep1s0f1
NCCL_CROSS_NIC=0
WORKER_SSH=samkimasus4@10.77.0.6

PORT=8888
DIST_PORT=26400
SERVED_MODEL_NAME=qwen38-flash-next-nvfp4-sglang
MEM_FRACTION_STATIC=0.80
CONTEXT_LENGTH=262144
CHUNKED_PREFILL_SIZE=1024
MAX_RUNNING_REQUESTS=6
ALLOW_AUTO_TRUNCATE=0

# NEXTN 3/1/4 (topk must stay 1; draft = steps + 1)
SPEC_STEPS=3
SPEC_TOPK=1
SPEC_DRAFT=4

ATTENTION_BACKEND=flashinfer
NVFP4_KV_CACHE=0
KV_CACHE_DTYPE=bf16
PLE_OFFLOAD=1
ENABLE_DECODE_GRAPHS=1
CUDA_GRAPH_BS=1 2 3 4 5 6

KERNEL_PATCH=1
BASE_IMAGE=lmsysorg/sglang@sha256:14ed582518584c5c830206b5318a2c2769e68229c3422e48a28b952b3a888bd4
PATCHED_IMAGE=local/qwen38-flashnext-sglang:sm121-344f9d
HF_REVISION=7b719225242aacd3dbd3f9407468c2ee9a9d2594
HF_HOME=/home/samkimasus2/.cache/qwen38-sglang-hf
WORKER_HF_HOME=/home/samkimasus4/.cache/qwen38-sglang-hf
DOWNLOAD_MODE=rsync
USE_HOST_NCCL=0

REASONING_PARSER=auto
TOOL_CALL_PARSER=qwen3_coder
# NOTE: no --disable-cuda-graph (removed 2026-09-12; decode graphs are the 2x lever)
EXTRA_ARGS=--moe-runner-backend flashinfer_cutlass --sampling-backend pytorch --disable-flashinfer-autotune --max-mamba-cache-size 97 --default-chat-template-kwargs {"enable_thinking":false,"preserve_thinking":false}
SPECULATIVE=1

# Effective serving image (overrides BASE/PATCHED above):
IMAGE=lmsysorg/sglang:nightly-dev-cu13-20260909-db272201
