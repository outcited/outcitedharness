        "conditions": {"ta_c": 85.0}
      },
      "expect": {"ok": 0, "not_comparable": 10, "out_of_range": 0, "insufficient": 0, "reason": "condition_mismatch"}
    },
    {
      "id": "P12-lmr-temp25",
      "description": "quiescent + shutdown current at 25 C, VIN swept",
      "request": {
        "phenomenon": "supply_current_vs_input_voltage",
        "operating_point": {"x": 12.0},
        "conditions": {"ta_c": 25.0}
      },
      "expect": {"ok": 2, "not_comparable": 4, "out_of_range": 4, "insufficient": 0}
    },
    {
      "id": "P13-lmr-temp125-en0",
      "description": "shutdown current at 125 C with EN = 0 V",
      "request": {
        "phenomenon": "supply_current_vs_input_voltage",
