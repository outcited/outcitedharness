        "conditions": {"ta_c": 125.0, "ven_v": 0.0}
      },
      "expect": {"ok": 1, "not_comparable": 9, "out_of_range": 0, "insufficient": 0}
    },
    {
      "id": "P14-lmr-above-range",
      "description": "45 V beyond the 40 V plotted maximum",
      "expect_out_of_range": true,
      "request": {
        "phenomenon": "supply_current_vs_input_voltage",
        "operating_point": {"x": 45.0}
      },
      "expect": {"ok": 0, "not_comparable": 0, "out_of_range": 10, "insufficient": 0}
    },
    {
      "id": "P15-lmr-profile-oob",
      "description": "load profile extending past the plotted support is refused whole",
      "must_reject": true,
      "request": {
        "phenomenon": "supply_current_vs_input_voltage",
