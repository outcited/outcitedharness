# 4x DGX Spark profile (TP4/EP4) — Harnessv1 site: dgx2 head + asus1/dgx3/asus3.
# Site deltas from .env.tp4.example are marked "# SITE".

# --- cluster ---
HEAD_IP=10.77.0.1
WORKER_IPS="10.77.0.2 10.77.0.3 10.77.0.4"
WORKER_HOSTS="10.77.0.2 10.77.0.3 10.77.0.4"
# SITE: our workers have three different usernames; start.sh patched to honor this list.
WORKER_USERS="samkimasus1 samkim3 samkimasus3"
WORKER_USER=samkim2
SSH_IDENTITY=$HOME/.ssh/id_ed25519

# --- fabric (ConnectX-7 RoCE, switched 10.77.0.0/23) ---
FABRIC_IFACE=enp1s0f1np1
GLOO_SOCKET_IFNAME=enp1s0f1np1
NCCL_SOCKET_IFNAME=enp1s0f1np1
IB_HCA=rocep1s0f1,roceP2p1s0f1
NCCL_NET=IB
NCCL_IB_DISABLE=0
NCCL_P2P_DISABLE=1
NCCL_SHM_DISABLE=1
NCCL_DEBUG=WARN
NCCL_BUFFSIZE=1048576
NCCL_LL128_BUFFSIZE=262144
NCCL_PROTO=^LL128
NCCL_MAX_NCHANNELS=8
NCCL_DEBUG_SUBSYS=INIT,ENV
NCCL_HOST_DIR=$HOME/nccl-2.30.7

# --- model / image ---
MODEL_DIR=/srv/models/DeepSeek-V4.1-Flash
COMMON_MODEL=/var/tmp/DeepSeek-V4.1-Flash
BASE_IMAGE=lmsysorg/sglang:dev-dsv41
IMAGE=dsv41-4x-spark:local
PORT=8888

# --- weights on workers ---
# SITE: NFS_SHARE=0. dgx2 already exports /srv/models via host nfsd (a second nfsd
# cannot bind 2049); each worker gets a bind volume over the existing /mnt/models.
NFS_SHARE=0
NFS_VOLUME=dsv41-weights
NFS_EXPORT_NAME=dsv41-native
NFS_SERVER_IPS=10.77.0.1
NFS_CLIENTS=10.77.0.2,10.77.0.3,10.77.0.4

# --- parallelism ---
NNODES=4
TP_SIZE=4
EP_SIZE=4
DIST_PORT=20000

# --- serving (MiaAI TP4 profile defaults) ---
OFFLOAD_MODE=nvme
DSV41_CACHE_GIB=0
DSV41_IO_THREADS=96
DSV41_RESIDENT_SCALES=0
DSV41_CACHE_WAYS=4
DSV41_STATS_SECONDS=60
CONTEXT_LENGTH=1048576
MEM_FRACTION_STATIC=0.80
HEAD_MEM_FRACTION_STATIC=0.80
MAX_RUNNING_REQUESTS=8
CHUNKED_PREFILL_SIZE=1024
MAX_TOTAL_TOKENS=8000000
SPEC_ALGO=DSPARK
DSPARK_BLOCK_SIZE=3
DSPARK_SPS_TABLE=/state/dspark_sps.json
DSPARK_STS_TABLE=/state/dspark_sts.json

# --- engram local shards ---
# SITE: WORKER_DIR is a shared absolute path (workers have different home dirs).
ENGRAM_DIR=$HOME/dsv41-engram
WORKER_DIR=/var/tmp/dsv41-4x-spark
DSV41_PACKED_DIR=/engram
SKIP_PREPARE=1
SKIP_VERIFY=1
SKIP_SMOKE=0
SMOKE_QUICK=1

# --- kernels ---
EXTRA_SGLANG_ARGS="--fp8-gemm-backend flashinfer_cutlass --watchdog-timeout 1800 --min-free-slots-delay 1"
DSV41_MXFP8_BACKEND=b12x
SGLANG_FLASHINFER_MOE_FUSED_FINALIZE=0
SGLANG_DSV41_REASONING_EFFORT=75
DSV41_MAX_NEW_TOKENS=32768
DSV41_LOOP_ABORT=1
DSV41_LOOP_NGRAM=32
DSV41_LOOP_REPEATS=4
DSV41_LOOP_LINE_REPEATS=8
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:False
DSV41_PREFILL_EMPTY_CACHE_TOKENS=8192
DSV41_TP_PAD=0
READY_TIMEOUT=1800
SHM_SIZE=32g
