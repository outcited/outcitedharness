{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://outcited.github.io/schemas/dw.finding.v1.json",
  "title": "DesignWins engineering finding",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "finding_id", "task_id", "source_url", "repository", "severity", "summary", "reproduction", "expected_behavior", "regression_tests", "authorization_state", "owner"],
  "properties": {
    "schema": {"const": "dw.finding.v1"},
    "finding_id": {"type": "string", "pattern": "^DW-NEO-[A-Z0-9]+-[0-9]+$",
      "description": "Unique, stable finding identifier assigned at publication"},
    "task_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9]+(-[A-Z0-9]+)*-[0-9]+$",
      "description": "Existing engineering task reference this finding reports on (gh_workloop TASK_ID_RE compatible)"},
    "source_url": {"type": "string", "format": "uri",
      "description": "Canonical URL of the published finding (GitHub issue, PR comment, or review)"},
    "repository": {"type": "string", "pattern": "^[^/]+/[^/]+$",
      "description": "slug the finding concerns, must be director-allowlisted for ingest"},
    "commit": {"type": "string", "description": "commit sha the finding was observed at"},
    "references": {"type": "array", "items": {"type": "object", "additionalProperties": false,
      "required": ["path"], "properties": {
        "path": {"type": "string"}, "line": {"type": "integer"}}}},
    "severity": {"enum": ["blocker", "critical", "major", "minor", "info"]},
    "engineering_impact": {"type": "string"},
    "summary": {"type": "string", "maxLength": 72,
      "description": "one-line summary; becomes the bead title suffix"},
    "detail": {"type": "string"},
    "reproduction": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "expected_behavior": {"type": "string"},
    "regression_tests": {"type": "object", "additionalProperties": false,
      "required": ["positive", "negative"],
      "properties": {
        "positive": {"type": "array", "minItems": 1, "items": {"type": "string"},
          "description": "tests that must pass after the fix"},
        "negative": {"type": "array", "minItems": 1, "items": {"type": "string"},
          "description": "tests that must fail / be refused before the fix (negative controls)"}}},
    "existing_associations": {"type": "object", "additionalProperties": false,
      "properties": {
        "issue": {"type": "integer"}, "pr": {"type": "integer"},
        "task_ref": {"type": "string"}}},
    "authorization_state": {"enum": ["proposal", "authorized", "refused", "superseded"],
      "description": "proposal findings are never dispatched; only a Sam approval artifact upgrades this"},
    "owner": {"type": "string", "description": "responsible owner label (LANE_REGISTRY style)"},
    "verification": {"type": "object", "additionalProperties": false,
      "properties": {
        "closed_by_bead": {"type": "string"},
        "pr": {"type": "integer"}, "ci": {"type": "string", "enum": ["passed", "failed", "pending", ""]},
        "receipt": {"type": "string"}}}
  }
}
