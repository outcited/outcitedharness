  "probes": [
    {
      "id": "P1-eff-fccm-10A",
      "description": "efficiency at 10 A, matched conditions, FCCM",
      "request": {
        "phenomenon": "efficiency_vs_load",
        "operating_point": {"x": 10.0},
        "conditions": {"vin_v": 12.0, "vout_v": 1.1, "categorical": {"mode": "fccm"}}
      },
      "expect": {"ok": 8, "not_comparable": 4, "out_of_range": 0, "insufficient": 0, "unpinned_dimensions": ["categorical.vcc"]}
    },
    {
      "id": "P2-eff-dcm-10A",
      "description": "efficiency at 10 A under DCM",
      "request": {
        "phenomenon": "efficiency_vs_load",
        "operating_point": {"x": 10.0},
        "conditions": {"vin_v": 12.0, "vout_v": 1.1, "categorical": {"mode": "dcm"}}
      },
      "expect": {"ok": 4, "not_comparable": 8, "out_of_range": 0, "insufficient": 0}
    },
    {
      "id": "P3-eff-vin24-mismatch",
      "description": "efficiency query at VIN = 24 V — no curve was measured there",
      "must_reject": true,
      "request": {
        "phenomenon": "efficiency_vs_load",
        "operating_point": {"x": 10.0},
        "conditions": {"vin_v": 24.0, "vout_v": 1.1}
      },
      "expect": {"ok": 0, "not_comparable": 12, "out_of_range": 0, "insufficient": 0, "reason": "condition_mismatch"}
    },
    {
      "id": "P4-eff-vin-missing",
      "description": "engineer omitted VIN — question insufficient, never defaulted",
      "must_reject": true,
      "request": {
        "phenomenon": "efficiency_vs_load",
        "operating_point": {"x": 10.0},
        "conditions": {"vout_v": 3.3}
      },
      "expect": {"ok": 0, "not_comparable": 0, "out_of_range": 0, "insufficient": 12, "reason": "condition_missing"}
    },
    {
      "id": "P4b-eff-vout33-mismatch",
      "description": "VOUT = 3.3 V stated but every curve was measured at 1.1 V",
      "must_reject": true,
      "request": {
        "phenomenon": "efficiency_vs_load",
        "operating_point": {"x": 10.0},
        "conditions": {"vin_v": 12.0, "vout_v": 3.3}
      },
      "expect": {"ok": 0, "not_comparable": 12, "out_of_range": 0, "insufficient": 0, "reason": "condition_mismatch"}
    },
    {
      "id": "P5-eff-above-range",
      "description": "load 40 A beyond the 35 A plotted maximum",
      "expect_out_of_range": true,
      "request": {
        "phenomenon": "efficiency_vs_load",
        "operating_point": {"x": 40.0},
        "conditions": {"vin_v": 12.0, "vout_v": 1.1, "categorical": {"mode": "fccm"}}
      },
      "expect": {"ok": 0, "not_comparable": 4, "out_of_range": 8, "insufficient": 0}
    },
    {
      "id": "P6-eff-below-range",
      "description": "load 0.001 A below the plotted minimum support",
      "expect_out_of_range": true,
      "request": {
        "phenomenon": "efficiency_vs_load",
        "operating_point": {"x": 0.001},
        "conditions": {"vin_v": 12.0, "vout_v": 1.1}
      },
      "expect": {"ok": 0, "not_comparable": 0, "out_of_range": 12, "insufficient": 0}
    },
    {
      "id": "P7-eff-load-profile",
      "description": "bounded load distribution (light-load weighted)",
      "request": {
        "use_case": "light_load_efficiency",
        "conditions": {"vin_v": 12.0, "vout_v": 1.1, "categorical": {"mode": "fccm"}},
        "load_profile": [
          {"x": 1.0, "weight": 0.5},
          {"x": 5.0, "weight": 0.3},
          {"x": 20.0, "weight": 0.2}
        ]
      },
      "expect": {"profile_ok": 8, "profile_not_comparable": 4, "ok": 0, "insufficient": 0}
    },
    {
      "id": "P8-pdiss-10A",
      "description": "power dissipation at 10 A, matched conditions",
      "request": {
        "phenomenon": "power_dissipation_vs_load",
        "operating_point": {"x": 10.0},
        "conditions": {"vin_v": 12.0, "vout_v": 1.1, "categorical": {"mode": "fccm"}}
      },
      "expect": {"ok": 8, "not_comparable": 4, "out_of_range": 0, "insufficient": 0}
    },
    {
      "id": "P9-wrong-phenomenon",
      "description": "supply-current-vs-temperature does not exist on this page",
      "request": {
        "phenomenon": "supply_current_vs_temperature",
        "operating_point": {"x": 25.0},
        "conditions": {"ta_c": 25.0}
      },
      "expect": {"applicable": 0, "ok": 0}
    },
    {
      "id": "P10-eff-no-op-point",
      "description": "discovery listing without an operating point",
      "request": {
        "phenomenon": "efficiency_vs_load",
        "conditions": {"vin_v": 12.0, "vout_v": 1.1}
      },
      "expect": {"applicable": 12, "listed": 12}
    },
    {
      "id": "P11-lmr-temp85-no-curve",
      "description": "85 C is not a printed legend temperature",
      "must_reject": true,
      "request": {
        "phenomenon": "supply_current_vs_input_voltage",
